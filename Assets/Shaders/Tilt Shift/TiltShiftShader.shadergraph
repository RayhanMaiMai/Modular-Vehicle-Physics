{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "d8ecf727c6134113bbee79fef42c0acb",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "TiltShiftBlur (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 2618.000244140625,
            "y": 559.0000610351563,
            "width": 221.0,
            "height": 101.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "fdacb429a5204cb9a86796f41a00819c"
        },
        {
            "m_Id": "816ab11718bd471ea3b8cc676592242c"
        },
        {
            "m_Id": "590cb92c7e1244a98cd7a3081c592b1f"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "TiltShiftBlur",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float2 texelSize = 1.0 / _ScreenParams.xy;\r\nfloat3 blurredColor = float3(0, 0, 0);\r\nfloat totalWeight = 0.0;\r\n\r\nfor(int x = -2; x <= 2; x++)\r\n{\r\n    for(int y = -2; y <= 2; y++)\r\n    {\r\n        // Menghitung offset jarak pixel berdasarkan BlurStrength\r\n        float2 offset = float2(x, y) * texelSize * BlurStrength;\r\n        \r\n        // Mengambil warna layar dari _BlitTexture (referensi URP standar)\r\n        float3 sampleColor = SAMPLE_TEXTURE2D(_BlitTexture, sampler_BlitTexture, UV + offset).rgb;\r\n        \r\n        // Memberikan bobot (weight) agar tengah lebih dominan dari ujung (Gaussian feel)\r\n        float weight = 1.0 - (abs(x) + abs(y)) * 0.15;\r\n        blurredColor += sampleColor * weight;\r\n        totalWeight += weight;\r\n    }\r\n}\r\nOutColor = blurredColor / totalWeight;"
}

